# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nexblog

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-me-too

# CORS — comma-separated list of allowed frontend origins (no trailing slash).
# In production set this to your deployed frontend URL, e.g. https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Auth cookie SameSite policy. Leave unset to auto-pick:
#   production -> "none" (required when frontend & API are on different domains)
#   development -> "lax"
# Only override if frontend + API share the same parent domain.
# COOKIE_SAMESITE=none

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Next.js revalidation webhook
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=nexblog

# ── AI provider (OPTIONAL) ────────────────────────────────────────────────
# The SEO analyzer, scoring, content briefs and localization all work fully
# WITHOUT this — AI only layers on semantic suggestions. Keys stay server-side.
# provider: none | openai | claude | gemini
AI_PROVIDER=none
AI_API_KEY=
# Optional model override, e.g. gpt-4o-mini | claude-3-5-haiku-latest | gemini-1.5-flash
AI_MODEL=
